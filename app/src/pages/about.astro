---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticNavbar from "@/components/layout/StaticNavbar.astro";
import StaticFooter from "@/components/layout/StaticFooter.astro";
---

<BaseLayout
    title="Tentang - Hotspot Karhutla"
    description="Platform analisis data hotspot kebakaran hutan dengan teknologi Spatial Online Analytical Processing untuk monitoring di seluruh Indonesia."
>
    <StaticNavbar />

    <section class="section-dark pt-20 pb-8">
        <div class="max-w-[1100px] mx-auto px-6">
            <div
                class="flex items-center space-x-2 text-[0.78rem] text-[#b8c8b1] mb-4"
            >
                <a href="/" class="hover:text-[#f3f7f1] transition-colors"
                    >Beranda</a
                >
                <span class="text-[#6b7a64]">/</span>
                <span class="text-[#f3f7f1] font-medium">Tentang</span>
            </div>
            <h1 class="text-2xl font-extrabold text-[#f3f7f1] mb-2">
                Tentang Sistem
            </h1>
            <p class="text-[0.9rem] text-[#b8c8b1] max-w-xl">
                Platform analisis data hotspot kebakaran hutan dengan teknologi
                Spatial Online Analytical Processing untuk monitoring di seluruh
                Indonesia.
            </p>
        </div>
    </section>

    <main class="bg-[#faf8f5] dark:bg-background">
        <section class="py-6 lg:py-8 px-6">
            <div class="max-w-[1100px] mx-auto">
                <h2
                    class="text-2xl font-extrabold text-[#192d17] dark:text-[#f3f7f1] mb-3 leading-tight"
                >
                    Apa Itu Hotspot Karhutla?
                </h2>
                <p
                    class="text-sm text-[#4a5648] dark:text-[#b8c8b1] leading-relaxed max-w-3xl mb-4"
                >
                    <strong>Hotspot Karhutla</strong> adalah sistem pemantauan dan
                    analisis data historikal titik panas kebakaran hutan dan lahan
                    di Indonesia. Data bersumber dari
                    <a
                        href="https://firms.modaps.eosdis.nasa.gov/"
                        target="_blank"
                        rel="noopener"
                        class="text-[#3d6b35] dark:text-[#8fc483] hover:underline font-semibold"
                        >NASA FIRMS</a
                    > dan
                    <a
                        href="https://www.visualcrossing.com/"
                        target="_blank"
                        rel="noopener"
                        class="text-[#3d6b35] dark:text-[#8fc483] hover:underline font-semibold"
                        >Visual Crossing</a
                    >, yang dikelola dalam data warehouse dengan skema bintang.
                </p>
                <p
                    class="text-sm text-[#4a5648] dark:text-[#b8c8b1] leading-relaxed max-w-3xl mb-4"
                >
                    Sistem ini menggunakan teknologi <strong>OLAP</strong> (Online
                    Analytical Processing) untuk mengelola data secara multidimensi
                    berdasarkan lokasi, waktu, confidence, dan satelit — mendukung
                    analisis data kompleks dari berbagai perspektif.
                </p>
                <p
                    class="text-sm text-[#4a5648] dark:text-[#b8c8b1] leading-relaxed max-w-3xl"
                >
                    Hasil analisis ditampilkan dalam bentuk tabel, grafik
                    interaktif, dan peta visualisasi geografis untuk analisis
                    mendalam.
                </p>
            </div>
        </section>

        <section class="py-16 px-6">
            <div class="max-w-[1100px] mx-auto">
                <h2
                    class="text-2xl font-extrabold text-[#192d17] dark:text-[#f3f7f1] mb-3 leading-tight"
                >
                    Fitur
                </h2>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div
                        style="background-color: #d4dad1; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Dashboard
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Visualisasi interaktif</strong> dengan operasi
                            OLAP untuk analisis data hotspot secara mendalam.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <rect
                                    x="10"
                                    y="70"
                                    width="35"
                                    height="60"
                                    rx="6"
                                    fill="#4ade80"></rect>
                                <rect
                                    x="55"
                                    y="45"
                                    width="35"
                                    height="85"
                                    rx="6"
                                    fill="#22c55e"></rect>
                                <rect
                                    x="100"
                                    y="20"
                                    width="35"
                                    height="110"
                                    rx="6"
                                    fill="#16a34a"></rect>
                                <rect
                                    x="145"
                                    y="55"
                                    width="35"
                                    height="75"
                                    rx="6"
                                    fill="#15803d"></rect>
                                <circle cx="27" cy="58" r="8" fill="#fbbf24"
                                ></circle>
                                <circle cx="72" cy="33" r="8" fill="#fbbf24"
                                ></circle>
                                <circle cx="117" cy="8" r="8" fill="#fbbf24"
                                ></circle>
                                <path
                                    d="M27 58 L72 33 L117 8"
                                    stroke="#fbbf24"
                                    stroke-width="3"
                                    stroke-linecap="round"></path>
                            </svg>
                        </div>
                    </div>

                    <div
                        style="background-color: #e5d8e8; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Peta Interaktif
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Pemetaan geografis</strong> hotspot dengan clustering
                            dan visualisasi distribusi titik panas.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <ellipse
                                    cx="100"
                                    cy="120"
                                    rx="90"
                                    ry="15"
                                    fill="#f9a8d4"
                                    opacity="0.5"></ellipse>
                                <path
                                    d="M20 100 Q60 70 100 85 T180 60"
                                    stroke="#f472b6"
                                    stroke-width="4"
                                    fill="none"></path>
                                <path
                                    d="M30 85 Q80 50 130 70 T190 45"
                                    stroke="#ec4899"
                                    stroke-width="3"
                                    fill="none"></path>
                                <circle
                                    cx="55"
                                    cy="55"
                                    r="16"
                                    fill="#ef4444"
                                    opacity="0.9"></circle>
                                <circle
                                    cx="90"
                                    cy="35"
                                    r="10"
                                    fill="#f97316"
                                    opacity="0.9"></circle>
                                <circle
                                    cx="130"
                                    cy="50"
                                    r="20"
                                    fill="#ef4444"
                                    opacity="0.9"></circle>
                                <circle
                                    cx="165"
                                    cy="30"
                                    r="12"
                                    fill="#f97316"
                                    opacity="0.9"></circle>
                                <rect
                                    x="75"
                                    y="10"
                                    width="40"
                                    height="25"
                                    rx="5"
                                    fill="#3b82f6"></rect>
                                <path
                                    d="M95 35 L95 50"
                                    stroke="#3b82f6"
                                    stroke-width="3"></path>
                            </svg>
                        </div>
                    </div>

                    <div
                        style="background-color: #e8e6e3; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Filter Dinamis
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Pemfilteran multidimensi</strong> berdasarkan
                            lokasi, waktu, confidence, dan satelit.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <path
                                    d="M30 15 L170 15 L130 70 L130 130 L70 130 L70 70 Z"
                                    fill="#a5b4fc"
                                    stroke="#6366f1"
                                    stroke-width="3"></path>
                                <ellipse
                                    cx="100"
                                    cy="15"
                                    rx="75"
                                    ry="18"
                                    fill="#c7d2fe"
                                    stroke="#6366f1"
                                    stroke-width="3"></ellipse>
                                <circle cx="55" cy="20" r="6" fill="#22c55e"
                                ></circle>
                                <circle cx="80" cy="12" r="6" fill="#ef4444"
                                ></circle>
                                <circle cx="105" cy="22" r="6" fill="#3b82f6"
                                ></circle>
                                <circle cx="130" cy="14" r="6" fill="#22c55e"
                                ></circle>
                                <circle cx="150" cy="20" r="6" fill="#fbbf24"
                                ></circle>
                                <circle cx="90" cy="100" r="5" fill="#22c55e"
                                ></circle>
                                <circle cx="110" cy="105" r="5" fill="#22c55e"
                                ></circle>
                            </svg>
                        </div>
                    </div>

                    <div
                        style="background-color: #e8dfd4; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Ekspor Data
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Unduh data</strong> hotspot dalam format Excel
                            (.xlsx) dan CSV untuk analisis lanjutan.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <rect
                                    x="20"
                                    y="10"
                                    width="95"
                                    height="115"
                                    rx="8"
                                    fill="#fde68a"
                                    stroke="#f59e0b"
                                    stroke-width="3"></rect>
                                <rect
                                    x="35"
                                    y="30"
                                    width="65"
                                    height="10"
                                    rx="3"
                                    fill="#f59e0b"></rect>
                                <rect
                                    x="35"
                                    y="50"
                                    width="45"
                                    height="8"
                                    rx="3"
                                    fill="#fbbf24"></rect>
                                <rect
                                    x="35"
                                    y="65"
                                    width="55"
                                    height="8"
                                    rx="3"
                                    fill="#fbbf24"></rect>
                                <rect
                                    x="35"
                                    y="80"
                                    width="40"
                                    height="8"
                                    rx="3"
                                    fill="#fbbf24"></rect>
                                <path
                                    d="M120 50 L120 115 L180 115 L180 72 L158 50 Z"
                                    fill="#22c55e"
                                    stroke="#16a34a"
                                    stroke-width="3"></path>
                                <path
                                    d="M158 50 L158 72 L180 72"
                                    fill="#bbf7d0"
                                    stroke="#16a34a"
                                    stroke-width="3"></path>
                                <text
                                    x="127"
                                    y="92"
                                    font-size="14"
                                    fill="white"
                                    font-weight="bold">XLSX</text
                                >
                            </svg>
                        </div>
                    </div>

                    <div
                        style="background-color: #dce4dd; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Tabel Data
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Tampilan tabel</strong> dengan mode detail dan
                            akumulasi, sorting, dan filter multidimensi.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <rect
                                    x="15"
                                    y="15"
                                    width="170"
                                    height="110"
                                    rx="10"
                                    fill="white"
                                    stroke="#3b82f6"
                                    stroke-width="3"></rect>
                                <rect
                                    x="15"
                                    y="15"
                                    width="170"
                                    height="28"
                                    rx="10"
                                    fill="#3b82f6"></rect>
                                <line
                                    x1="70"
                                    y1="43"
                                    x2="70"
                                    y2="125"
                                    stroke="#bfdbfe"
                                    stroke-width="2"></line>
                                <line
                                    x1="130"
                                    y1="43"
                                    x2="130"
                                    y2="125"
                                    stroke="#bfdbfe"
                                    stroke-width="2"></line>
                                <line
                                    x1="15"
                                    y1="70"
                                    x2="185"
                                    y2="70"
                                    stroke="#bfdbfe"
                                    stroke-width="2"></line>
                                <line
                                    x1="15"
                                    y1="97"
                                    x2="185"
                                    y2="97"
                                    stroke="#bfdbfe"
                                    stroke-width="2"></line>
                                <circle cx="42" cy="56" r="7" fill="#22c55e"
                                ></circle>
                                <circle cx="42" cy="83" r="7" fill="#f97316"
                                ></circle>
                                <circle cx="42" cy="110" r="7" fill="#22c55e"
                                ></circle>
                                <rect
                                    x="85"
                                    y="52"
                                    width="35"
                                    height="8"
                                    rx="3"
                                    fill="#93c5fd"></rect>
                                <rect
                                    x="85"
                                    y="79"
                                    width="28"
                                    height="8"
                                    rx="3"
                                    fill="#93c5fd"></rect>
                                <rect
                                    x="85"
                                    y="106"
                                    width="40"
                                    height="8"
                                    rx="3"
                                    fill="#93c5fd"></rect>
                            </svg>
                        </div>
                    </div>

                    <div
                        style="background-color: #ddd8e4; border-radius: 1.5rem;"
                        class="p-8 flex flex-col min-h-[450px]"
                    >
                        <h3
                            style="color: #2d3a2e;"
                            class="text-xl font-medium mb-6"
                        >
                            Update Berkala
                        </h3>
                        <p
                            style="color: #4a5648;"
                            class="text-sm leading-relaxed"
                        >
                            <strong>Data diperbarui</strong> secara berkala dari NASA
                            FIRMS untuk analisis terkini.
                        </p>
                        <div class="flex-1 flex items-end justify-center pt-6">
                            <svg
                                class="w-full max-w-[240px] h-auto"
                                viewBox="0 0 200 140"
                                fill="none"
                            >
                                <circle
                                    cx="100"
                                    cy="75"
                                    r="45"
                                    fill="none"
                                    stroke="#d8b4fe"
                                    stroke-width="10"></circle>
                                <path
                                    d="M100 38 A37 37 0 1 1 63 75"
                                    fill="none"
                                    stroke="#a855f7"
                                    stroke-width="10"
                                    stroke-linecap="round"></path>
                                <path d="M100 26 L100 48 L84 37" fill="#a855f7"
                                ></path>
                                <circle cx="100" cy="75" r="22" fill="#f3e8ff"
                                ></circle>
                                <path
                                    d="M90 75 L97 82 L112 64"
                                    stroke="#7c3aed"
                                    stroke-width="5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                                <rect
                                    x="148"
                                    y="18"
                                    width="42"
                                    height="30"
                                    rx="6"
                                    fill="#fef3c7"
                                    stroke="#f59e0b"
                                    stroke-width="2"></rect>
                                <text
                                    x="156"
                                    y="39"
                                    font-size="13"
                                    fill="#f59e0b"
                                    font-weight="bold">24h</text
                                >
                                <circle cx="35" cy="40" r="10" fill="#fbbf24"
                                ></circle>
                                <circle cx="155" cy="120" r="8" fill="#60a5fa"
                                ></circle>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-16 px-6">
            <div class="max-w-[1100px] mx-auto">
                <h2
                    class="text-2xl font-extrabold text-[#192d17] dark:text-[#f3f7f1] mb-6 leading-tight"
                >
                    Struktur Data & Operasi
                </h2>

                <div
                    class="struktur-card"
                    style="background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 20px; padding: 48px;"
                >
                    <div class="flex flex-col md:flex-row gap-10">
                        <div class="md:w-1/2">
                            <svg
                                class="struktur-icon w-12 h-12 text-[#192d17] mb-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
                                ></path>
                            </svg>
                            <h3
                                class="struktur-title text-xl font-semibold text-[#192d17] mb-3 leading-snug"
                            >
                                Skema Galaxy dengan dua tabel fakta
                            </h3>
                            <p
                                class="struktur-desc text-sm text-[#6b7a64] leading-relaxed"
                            >
                                Data hotspot dan cuaca disimpan dalam tabel
                                fakta terpisah, namun berbagi dimensi lokasi dan
                                periode untuk analisis lintas domain.
                            </p>
                        </div>

                        <div class="md:w-1/2 flex flex-col gap-3">
                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Fakta Hotspot
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    FRP, brightness, koordinat
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Fakta Weather
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Suhu, kelembaban, curah hujan
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Dimensi Bersama
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Lokasi &amp; Periode
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Dimensi Spesifik
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Confidence, Satelit, Kondisi
                                </p>
                            </div>
                        </div>
                    </div>

                    <div
                        class="struktur-divider my-10"
                        style="border-top: 1px solid #e5e5e5;"
                    >
                    </div>

                    <div class="flex flex-col md:flex-row gap-10">
                        <div class="md:w-1/2 flex flex-col gap-3">
                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Drill-down
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Navigasi dari umum ke detail
                                </p>
                                <p
                                    class="text-xs text-[#c07f10] dark:text-[#f5b84d] mt-2"
                                >
                                    pulau → provinsi → kab/kota → desa
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Roll-up
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Agregasi dari detail ke ringkasan
                                </p>
                                <p
                                    class="text-xs text-[#c07f10] dark:text-[#f5b84d] mt-2"
                                >
                                    desa → kab/kota → provinsi → pulau
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Slice
                                </h4>
                                <p
                                    class="struktur-item-desc text-xs text-[#6b7a64] mt-1.5"
                                >
                                    Filter satu dimensi
                                </p>
                                <p
                                    class="text-xs text-[#c07f10] dark:text-[#f5b84d] mt-2"
                                >
                                    confidence = high
                                </p>
                            </div>

                            <div
                                class="struktur-item"
                                style="border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px 20px;"
                            >
                                <h4
                                    class="struktur-item-title text-sm font-semibold text-[#192d17]"
                                >
                                    Dice
