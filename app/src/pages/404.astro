---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
import { Home, Search } from 'lucide-react';
---

<BaseLayout title="404 - Halaman Tidak Ditemukan">
  <div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4">
    <div class="text-center space-y-6 max-w-md">
      <div class="relative">
        <h1 class="text-9xl font-bold text-muted-foreground/20 select-none">
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <Search className="w-16 h-16 text-muted-foreground/40" />
        </div>
      </div>

      <div class="space-y-2">
        <h2 class="text-2xl font-semibold text-foreground">
          Halaman Tidak Ditemukan
        </h2>
        <p class="text-muted-foreground">
          Maaf, halaman yang Anda cari tidak tersedia atau telah dipindahkan.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center pt-4">
        <Button asChild size="lg">
          <a href="/" class="inline-flex items-center gap-2" title="Kembali ke Halaman Beranda">
            <Home className="w-4 h-4" />
            Kembali ke Beranda
          </a>
        </Button>
        <Button asChild variant="outline" size="lg">
          <a href="/map" title="Lihat Peta Persebaran Hotspot Karhutla">
            Lihat Peta Hotspot
          </a>
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
