---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StaticNavbar from '@/components/layout/StaticNavbar.astro';
import StaticFooter from '@/components/layout/StaticFooter.astro';
import HotspotDataTableWithTheme from '@/components/HotspotDataTableWithTheme';
---

<BaseLayout
  title="Data Hotspot - Tabel Data Karhutla Indonesia"
  description="Akses data hotspot kebakaran hutan dan lahan Indonesia dalam format tabel dengan filter, sorting, dan export Excel/CSV. Data bersumber dari SIPONGI+ Kementerian LHK."
>

  <StaticNavbar />
  <main class="min-h-screen flex flex-col bg-gray-50 dark:bg-gray-900 pt-16">
    <div class="border-b border-gray-200/60 dark:border-gray-700/60 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex items-center space-x-2 text-sm text-gray-600 dark:text-gray-400">
          <a href="/" class="hover:text-gray-900 dark:hover:text-gray-200 transition-colors" title="Kembali ke Beranda">Beranda</a>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-gray-900 dark:text-gray-100 font-medium">Data Hotspot</span>
        </div>
      </div>
    </div>

    <HotspotDataTableWithTheme client:idle />
  </main>

  <StaticFooter />
</BaseLayout>
