---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavbarWithTheme from '@/components/NavbarWithTheme';
import BreadcrumbWrapper from '@/components/layout/BreadcrumbWrapper';
import Footer from '@/components/layout/Footer';
import OfflineBanner from '@/components/layout/OfflineBanner';
---

<BaseLayout
  title="Data Hotspot - Tabel Data Karhutla Indonesia"
  description="Akses data hotspot kebakaran hutan dan lahan Indonesia dalam format tabel dengan filter, sorting, dan export Excel/CSV. Data bersumber dari SIPONGI+ Kementerian LHK."
>
  <link rel="dns-prefetch" href="//sipongi.menlhk.go.id" />

  <OfflineBanner client:idle />
  <NavbarWithTheme client:load />
  <main class="min-h-screen flex flex-col bg-background pt-16">
    <div class="border-b border-border py-3 bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <BreadcrumbWrapper client:load items={[{ label: 'Data' }]} />
      </div>
    </div>

    <div id="hotspot-table-container" class="min-h-[400px] bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-card rounded-lg shadow overflow-hidden">
          <div class="px-6 py-4 border-b border-border">
            <div class="flex justify-between items-center">
              <div class="h-6 bg-muted rounded w-32 animate-pulse"></div>
              <div class="flex space-x-2">
                <div class="h-8 bg-muted rounded w-24 animate-pulse"></div>
                <div class="h-8 bg-muted rounded w-24 animate-pulse"></div>
              </div>
            </div>
          </div>

          <div class="divide-y divide-border">
            {[...Array(5)].map((_, i) => (
              <div class="px-6 py-4" key={`skeleton-${i}`}>
                <div class="flex space-x-4">
                  <div class="h-4 bg-muted rounded w-16 animate-pulse"></div>
                  <div class="h-4 bg-muted rounded w-24 animate-pulse"></div>
                  <div class="h-4 bg-muted rounded w-20 animate-pulse"></div>
                  <div class="h-4 bg-muted rounded w-16 animate-pulse"></div>
                  <div class="h-4 bg-muted rounded w-28 animate-pulse"></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
  <footer>
    <Footer client:idle />
  </footer>

  <script>
    const requestIdleCallback = window.requestIdleCallback || ((cb) => setTimeout(cb, 200));

    const loadTableComponent = () => {
      Promise.all([
        import('react'),
        import('react-dom/client')
      ]).then(([React, ReactDOM]) => {
        import('@/components/HotspotDataTableWithTheme.tsx').then(module => {
          const HotspotDataTableWithTheme = module.default;
          const container = document.getElementById('hotspot-table-container');

          if (container) {
            const root = ReactDOM.createRoot(container);
            root.render(React.createElement(HotspotDataTableWithTheme));
          }
        }).catch(err => {
          const container = document.getElementById('hotspot-table-container');
          if (container) {
            container.innerHTML = `
              <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                <div class="bg-destructive/10 border border-destructive/20 rounded-lg p-6 text-center">
                  <p class="text-destructive font-medium">⚠️ Gagal memuat tabel data</p>
                  <p class="text-sm text-muted-foreground mt-2">Silakan refresh halaman atau coba koneksi yang lebih stabil</p>
                </div>
              </div>
            `;
          }
        });
      });
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadTableComponent);
    } else {
      setTimeout(loadTableComponent, 200);
    }
  </script>
</BaseLayout>
