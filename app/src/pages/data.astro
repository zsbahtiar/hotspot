---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticNavbar from "@/components/layout/StaticNavbar.astro";
import StaticFooter from "@/components/layout/StaticFooter.astro";
import HotspotDataTableWithTheme from "@/components/HotspotDataTableWithTheme";
---

<BaseLayout
    title="Data Hotspot - Tabel Data Karhutla Indonesia"
    description="Akses data hotspot kebakaran hutan dan lahan Indonesia dalam format tabel dengan filter, sorting, dan export Excel/CSV. Data bersumber dari SIPONGI+ Kementerian LHK."
>
    <StaticNavbar />

    <section class="section-dark pt-20 pb-8">
        <div class="max-w-[1100px] mx-auto px-6">
            <div
                class="flex items-center space-x-2 text-[0.78rem] text-[#b8c8b1] mb-4"
            >
                <a
                    href="/"
                    class="hover:text-[#f3f7f1] transition-colors"
                    title="Kembali ke Beranda">Beranda</a
                >
                <span class="text-[#6b7a64]">/</span>
                <span class="text-[#f3f7f1] font-medium">Data Hotspot</span>
            </div>

            <h1 class="text-2xl font-extrabold text-[#f3f7f1] mb-2">
                Data Tabel Hotspot
            </h1>
            <p class="text-[0.9rem] text-[#b8c8b1] max-w-xl">
                Data titik panas karhutla dengan filter lokasi, tanggal, dan
                tingkat confidence. Export ke Excel atau CSV.
            </p>
        </div>
    </section>

    <main class="min-h-screen flex flex-col bg-[#faf8f5] dark:bg-background">
        <HotspotDataTableWithTheme client:idle />
    </main>

    <StaticFooter />
</BaseLayout>
