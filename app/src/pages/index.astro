---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticNavbar from "@/components/layout/StaticNavbar.astro";
import StaticFooter from "@/components/layout/StaticFooter.astro";
import StaticMitigationSection from "@/components/layout/StaticMitigationSection.astro";
import DashboardWithTheme from "@/components/DashboardWithTheme";

// Calculate year in frontmatter for proper prop serialization
const currentYear = new Date().getFullYear();
---

<BaseLayout
    title="OLAP Hotspot - Sistem Pemantauan Titik Panas Karhutla"
    description="Sistem Pemantauan Hotspot Karhutla bersumber dari SIPONGI+ menggunakan teknologi Spatial Online Analytical Processing untuk menganalisis titik panas karhutla di Indonesia."
>
    <StaticNavbar />

    <section class="section-dark pt-20 pb-12">
        <div class="max-w-[1100px] mx-auto px-6">
            <div
                class="flex flex-col md:flex-row md:items-end md:justify-between gap-8"
            >
                <!-- Left: Main Counter -->
                <div>
                    <p
                        class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[#b8c8b1] mb-2"
                    >
                        TOTAL TITIK PANAS {currentYear} di Indonesia
                    </p>
                    <div
                        class="counter-number text-[#f3f7f1]"
                        id="total-counter"
                    >
                        --
                    </div>
                    <p class="text-[0.74rem] text-[#b8c8b1] mt-2">
                        Updated <span id="last-update">--</span> · Data sejak Jan 2015
                    </p>
                </div>

                <!-- Right: Today Stats Box -->
                <div class="pace-box min-w-[180px]">
                    <p
                        class="text-[0.62rem] font-semibold uppercase tracking-[0.1em] text-[#b8c8b1] mb-1"
                    >
                        HARI INI
                    </p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-[#e4991b] text-sm">▲</span>
                        <span
                            class="text-3xl font-extrabold text-[#f3f7f1]"
                            id="today-counter">--</span
                        >
                    </div>
                    <p class="text-[0.72rem] text-[#b8c8b1] mt-1">
                        <span id="today-change">--</span> vs kemarin
                    </p>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="flex flex-wrap gap-3 mt-8">
                <a
                    href="/map"
                    class="inline-flex items-center px-5 py-2.5 bg-white/10 text-[#f3f7f1] text-sm font-semibold rounded-lg hover:bg-white/15 transition-all duration-200 border border-white/15"
                    title="Lihat Peta Persebaran Hotspot"
                >
                    <svg
                        class="w-4 h-4 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
                        ></path>
                    </svg>
                    Lihat Peta
                </a>
                <a
                    href="/data"
                    class="inline-flex items-center px-5 py-2.5 bg-transparent text-[#b8c8b1] text-sm font-semibold rounded-lg hover:text-[#f3f7f1] hover:bg-white/5 transition-all duration-200 border border-white/10"
                    title="Lihat Data Tabel"
                >
                    <svg
                        class="w-4 h-4 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                    </svg>
                    Lihat Data
                </a>
            </div>
        </div>
    </section>

    <!-- Dashboard Content - React Component (Loaded on idle) -->
    <DashboardWithTheme client:idle currentYear={currentYear} />

    <StaticFooter />

    <script>
        // Use requestIdleCallback for non-critical tasks
        const requestIdleCallback =
            window.requestIdleCallback || ((cb) => setTimeout(cb, 1));

        // Defer Service Worker registration to idle time
        requestIdleCallback(() => {
            if ("serviceWorker" in navigator) {
                navigator.serviceWorker.register("/sw.js").catch(() => {});
            }
        });
    </script>
</BaseLayout>
