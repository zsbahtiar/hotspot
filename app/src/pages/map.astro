---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticNavbar from "@/components/layout/StaticNavbar.astro";
import StaticFooter from "@/components/layout/StaticFooter.astro";
import OlapPage from "@/components/olap/OlapPage";
---

<BaseLayout
    title="Peta Hotspot Karhutla - Visualisasi Geografis"
    description="Peta interaktif hotspot kebakaran hutan dan lahan Indonesia dengan operasi OLAP (drill-down, roll-up) untuk analisis mendalam berdasarkan lokasi, waktu, confidence, dan satelit."
>
    <link rel="dns-prefetch" href="//tile.openstreetmap.fr" />
    <link rel="preconnect" href="//tile.openstreetmap.fr" crossorigin />
    <link rel="dns-prefetch" href="//raw.githubusercontent.com" />

    <StaticNavbar />

    <section class="section-dark pt-20 pb-8">
        <div class="max-w-[1100px] mx-auto px-6">
            <div
                class="flex items-center space-x-2 text-[0.78rem] text-[#b8c8b1] mb-4"
            >
                <a
                    href="/"
                    class="hover:text-[#f3f7f1] transition-colors"
                    title="Kembali ke Beranda">Beranda</a
                >
                <span class="text-[#6b7a64]">/</span>
                <span class="text-[#f3f7f1] font-medium">Peta</span>
            </div>

            <h1 class="text-2xl font-extrabold text-[#f3f7f1] mb-2">
                Peta Persebaran Hotspot
            </h1>
            <p class="text-[0.9rem] text-[#b8c8b1] max-w-xl">
                Visualisasi geografis titik panas karhutla dengan operasi OLAP
                untuk analisis mendalam.
            </p>
        </div>
    </section>

    <div class="min-h-screen bg-[#faf8f5] dark:bg-background">
        <OlapPage client:only="react" />
    </div>

    <StaticFooter />
</BaseLayout>
