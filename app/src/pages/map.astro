---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StaticNavbar from '@/components/layout/StaticNavbar.astro';
import StaticFooter from '@/components/layout/StaticFooter.astro';
import OlapPage from '@/components/olap/OlapPage';
---

<BaseLayout
  title="Peta Hotspot Karhutla - Visualisasi Geografis Real-time"
  description="Peta interaktif hotspot kebakaran hutan dan lahan Indonesia dengan operasi OLAP (drill-down, roll-up) untuk analisis mendalam berdasarkan lokasi, waktu, confidence, dan satelit."
>
  <link rel="dns-prefetch" href="//tile.openstreetmap.fr" />
  <link rel="preconnect" href="//tile.openstreetmap.fr" crossorigin />
  <link rel="dns-prefetch" href="//raw.githubusercontent.com" />

  <StaticNavbar />

  <div class="min-h-screen pt-16">
    <OlapPage client:only="react" />
  </div>
</BaseLayout>
