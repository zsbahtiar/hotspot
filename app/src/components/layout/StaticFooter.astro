---
const currentYear = new Date().getFullYear();
---

<footer class="section-dark mt-auto">
    <div class="max-w-[1100px] mx-auto px-6 py-8">
        <div
            class="flex flex-col md:flex-row md:items-center md:justify-between gap-6"
        >
            <!-- Left: Brand -->
            <div>
                <p class="text-[#f3f7f1] font-bold text-base">
                    Hotspot Karhutla
                </p>
                <p class="text-[#b8c8b1] text-xs">
                    Sistem Pemantauan Titik Panas
                </p>
            </div>

            <!-- Right: Links + Credits -->
            <div
                class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6 text-[0.78rem]"
            >
                <a
                    href="/about"
                    class="text-[#b8c8b1] hover:text-[#f3f7f1] transition-colors"
                >
                    Tentang
                </a>
                <span class="hidden md:inline text-[#4a5648]">·</span>
                <span class="text-[#6b7a64]">
                    &copy; {currentYear}
                </span>
            </div>
        </div>
    </div>
</footer>
